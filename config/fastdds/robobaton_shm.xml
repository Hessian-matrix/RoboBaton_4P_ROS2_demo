<?xml version="1.0" encoding="UTF-8"?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>robobaton_shm</transport_id>
      <type>SHM</type>
      <!-- Each participant owns a segment. Three participants reserve 768 MiB
           plus DDS metadata, leaving room in the target's 1.5 GiB SHM budget. -->
      <segment_size>268435456</segment_size>
      <port_queue_capacity>1024</port_queue_capacity>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="robobaton_shm_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>robobaton_shm</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
  <publisher profile_name="robobaton_default_writer" is_default_profile="true">
    <qos>
      <publishMode><kind>SYNCHRONOUS</kind></publishMode>
      <data_sharing><kind>OFF</kind></data_sharing>
    </qos>
    <historyMemoryPolicy>PREALLOCATED_WITH_REALLOC</historyMemoryPolicy>
  </publisher>
  <subscriber profile_name="robobaton_default_reader" is_default_profile="true">
    <qos><data_sharing><kind>OFF</kind></data_sharing></qos>
    <historyMemoryPolicy>PREALLOCATED_WITH_REALLOC</historyMemoryPolicy>
  </subscriber>
  <!-- Large images use the DDS send owner; small sensor/association records
       stay synchronous so image history cannot delay or evict them. -->
  <publisher profile_name="/robobaton/cam0/image_raw">
    <qos>
      <publishMode><kind>ASYNCHRONOUS</kind></publishMode>
      <data_sharing><kind>OFF</kind></data_sharing>
    </qos>
    <historyMemoryPolicy>PREALLOCATED_WITH_REALLOC</historyMemoryPolicy>
  </publisher>
  <publisher profile_name="/robobaton/cam1/image_raw">
    <qos>
      <publishMode><kind>ASYNCHRONOUS</kind></publishMode>
      <data_sharing><kind>OFF</kind></data_sharing>
    </qos>
    <historyMemoryPolicy>PREALLOCATED_WITH_REALLOC</historyMemoryPolicy>
  </publisher>
  <publisher profile_name="/robobaton/cam2/image_raw">
    <qos>
      <publishMode><kind>ASYNCHRONOUS</kind></publishMode>
      <data_sharing><kind>OFF</kind></data_sharing>
    </qos>
    <historyMemoryPolicy>PREALLOCATED_WITH_REALLOC</historyMemoryPolicy>
  </publisher>
  <publisher profile_name="/robobaton/cam3/image_raw">
    <qos>
      <publishMode><kind>ASYNCHRONOUS</kind></publishMode>
      <data_sharing><kind>OFF</kind></data_sharing>
    </qos>
    <historyMemoryPolicy>PREALLOCATED_WITH_REALLOC</historyMemoryPolicy>
  </publisher>
</profiles>
